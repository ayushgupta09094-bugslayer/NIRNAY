# Firebase project used by Firebase Admin SDK for ID-token verification and Firestore.
FIREBASE_PROJECT_ID=your-project-id
# Needed only when uploading files to Firebase Storage; Storage may require Blaze billing.
FIREBASE_STORAGE_BUCKET=your-actual-storage-bucket
# Keep this private JSON file inside backend/ and never commit it.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_TEST_NOTIFICATIONS=false
