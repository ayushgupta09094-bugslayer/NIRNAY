# PostgreSQL stores application profiles, records, document metadata, and push installations.
# Create database "nirnay" and role "nirnay_user"; URL-encode special password characters.
DATABASE_URL=postgresql+psycopg2://nirnay_user:change-me@127.0.0.1:5432/nirnay

# Firebase Admin is used for ID-token verification, Firebase Storage, and Cloud Messaging only.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_TEST_NOTIFICATIONS=false
